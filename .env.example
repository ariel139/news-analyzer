# Copy to .env and adjust. All settings: src/news_analyzer/config.py (prefix NA_).
NA_OLLAMA_URL=http://localhost:11434      # in Docker: http://host.docker.internal:11434
NA_LLM_MODEL=qwen3:8b                     # qwen3:4b = faster/weaker, qwen3:14b = GPU
NA_ANALYZE_MAX_PER_RUN=3                  # LLM calls per 15-min cycle
NA_ANALYZE_TIME_BUDGET_SEC=600            # stop starting new analyses after this
NA_AUTHOR_MIN_ARTICLES=5
# NA_DB_PATH=data/news.db
# NA_COLLECT_INTERVAL_MIN=15
# NA_TEXT_RETENTION_DAYS=30

# Optional hosted LLM instead of Ollama. WARNING: article text is sent to the provider.
# Set a monthly spending limit on the key in the provider dashboard.
# NA_LLM_PROVIDER=openai
# NA_LLM_MODEL=<provider model id, e.g. google/gemma-4-26b-a4b-it>
# NA_LLM_API_KEY=
# NA_LLM_API_PROVIDERS=deepinfra   # pin a provider that enforces the JSON schema (many don't)
# NA_LLM_API_URL=https://openrouter.ai/api/v1
# NA_LLM_MAX_COST_USD_PER_RUN=0.05
